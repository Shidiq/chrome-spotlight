{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "name": "URL Spotlight",
  "version": "1.9.0",
  "description": "Spotlight-style overlay to search open tabs, bookmarks, and history — or open any URL — from any page.",
  "permissions": ["activeTab", "tabs", "tabGroups", "bookmarks", "history", "storage", "scripting", "favicon", "identity", "sidePanel"],
  "key": "",
  "oauth2": {
    "client_id": "387650594829-kj4us7ndd4bfq09204h43cf447j797cs.apps.googleusercontent.com",
    "scopes": ["openid", "email", "https://www.googleapis.com/auth/calendar.readonly"]
  },
  "host_permissions": ["<all_urls>", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*", "https://api.notion.com/*"],
  "web_accessible_resources": [
    {
      "resources": ["_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Toggle sidebar"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["loader.js", "loading.js", "sidebar-shift.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "loader.js",
        "query.js",
        "content.js",
        "tabgroups.js",
        "sidebar-css.js",
        "sidebar-data.js",
        "sidebar-view.js",
        "sidebar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open Spotlight"
    },
    "switch-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Open Spotlight (alternate shortcut)"
    },
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Toggle sidebar"
    }
  }
}
