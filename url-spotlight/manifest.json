{
  "manifest_version": 3,
  "name": "URL Spotlight",
  "version": "1.0.0",
  "description": "Spotlight-style URL bar overlay. Press Ctrl+T to navigate or search from any page.",
  "permissions": ["activeTab", "bookmarks", "history"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open URL Spotlight"
    }
  }
}
