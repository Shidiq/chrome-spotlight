{
  "manifest_version": 3,
  "name": "URL Spotlight",
  "version": "1.0.0",
  "description": "Spotlight-style URL bar overlay. Press Ctrl+T to navigate or search from any page.",
  "permissions": ["activeTab", "tabs", "bookmarks", "history", "storage"],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "commands": {
    "toggle-spotlight": {
      "suggested_key": {
        "default": "Ctrl+T",
        "mac": "Command+T"
      },
      "description": "Open URL Spotlight"
    },
    "switch-tabs": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "Command+Shift+O"
      },
      "description": "Switch to an open tab"
    }
  }
}
